generator client {
 provider = "prisma-client"
 output = "../../generated/orders"
 importFileExtension = "js"
}
datasource db {
 provider = "postgresql"
}
model Order {
 id Int @id @default(autoincrement())
 userId Int
 description String
 total Decimal @db.Decimal(10, 2)
 createdAt DateTime @default(now())
}
